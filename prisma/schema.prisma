// Generic URL shortener for any links
model ShortLink {
  id          Int       @id @default(autoincrement())
  shortCode   String    @unique @db.VarChar(10) // Short unique identifier (e.g., "abc123")
  originalUrl String    @unique @db.VarChar(767) // The original URL - unique to prevent duplicates
  title       String?   @db.VarChar(255) // Optional title for the link
  description String?   @db.Text // Optional description
  clicks      Int       @default(0) // Track number of clicks
  isActive    Boolean   @default(true) // Allow enabling/disabling links
  expiresAt   DateTime? // Optional expiration date
  createdBy   Int? // Optional user who created the link
  companyId   Int? // Optional company association
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")

  user    User?    @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([shortCode])
  @@index([createdBy])
  @@index([companyId])
  @@index([isActive])
}

model VehicleParts {
  id           Int         @id @default(autoincrement())
  partsName    String
  technicianId Int?        @map("technician_id")
  invoiceId    String      @map("invoice_id")
  serviceId    Int?        @map("service_id")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @default(now()) @updatedAt @map("updated_at")
  technician   Technician? @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  invoice      Invoice?    @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  service      Service?    @relation(fields: [serviceId], references: [id], onDelete: Cascade)
}

// Platform Billing & Subscriptions

model PlatformPlan {
  id              String               @id @default(cuid())
  name            String               @unique // e.g. "Starter (Text Only)"
  description     String?              @db.Text
  price           Decimal              @db.Decimal(10, 2)
  interval        PlatformPlanInterval @default(MONTHLY)
  trialLengthDays Int                  @default(0)
  displayOrder    Int                  @default(0)
  isActive        Boolean              @default(true)
  companyId       Int?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  company       Company?               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  features      PlanFeature[]
  subscriptions PlatformSubscription[]
}

model PlanFeature {
  id         String              @id @default(cuid())
  planId     String
  featureKey String // e.g. "can_use_voice"
  value      String // e.g. "true" or "3"
  type       PlatformFeatureType @default(BOOLEAN)

  plan PlatformPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, featureKey])
}

model PlatformBillingCustomer {
  id               String    @id @default(cuid())
  companyId        Int       @unique
  authNetProfileId String?   @unique // Authorize.net customerProfileId
  email            String?
  taxId            String?
  trialConsumedAt  DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  company        Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  subscriptions  PlatformSubscription[]
  paymentMethods PlatformPaymentMethod[]
  invoices       PlatformInvoice[]
}

model PlatformSubscription {
  id                    String                     @id @default(cuid())
  companyId             Int                        @unique
  billingCustomerId     String
  planId                String
  status                PlatformSubscriptionStatus @default(ACTIVE)
  billingAnchor         DateTime? // next charge date
  cancelAtPeriodEnd     Boolean                    @default(false)
  authNetSubscriptionId String?                    @unique
  currentPeriodStart    DateTime                   @default(now())
  currentPeriodEnd      DateTime?
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt

  company         Company                    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  billingCustomer PlatformBillingCustomer    @relation(fields: [billingCustomerId], references: [id], onDelete: Cascade)
  plan            PlatformPlan               @relation(fields: [planId], references: [id])
  items           PlatformSubscriptionItem[]
}

model PlatformSubscriptionItem {
  id             String   @id @default(cuid())
  subscriptionId String
  name           String // e.g. "Growth Plan" or "Website Add-on"
  price          Decimal  @db.Decimal(10, 2)
  quantity       Int      @default(1)
  isOneTime      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  subscription PlatformSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
}

model PlatformPaymentMethod {
  id                      String   @id @default(cuid())
  billingCustomerId       String
  authNetPaymentProfileId String   @unique // Authorize.net paymentProfileId
  cardType                String? // e.g. "Visa"
  last4                   String?
  expiry                  String?
  isDefault               Boolean  @default(false)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  billingCustomer PlatformBillingCustomer @relation(fields: [billingCustomerId], references: [id], onDelete: Cascade)
}

model PlatformInvoice {
  id                String   @id @default(cuid())
  billingCustomerId String
  subscriptionId    String?
  amount            Decimal  @db.Decimal(10, 2)
  status            String // e.g. "PAID", "OPEN", "VOID"
  authNetTransId    String?  @unique // Linking to a specific capture trans
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  billingCustomer PlatformBillingCustomer @relation(fields: [billingCustomerId], references: [id], onDelete: Cascade)
  payments        PlatformPayment[]
}

model PlatformPayment {
  id                String   @id @default(cuid())
  platformInvoiceId String
  amount            Decimal  @db.Decimal(10, 2)
  status            String
  authNetTransId    String?  @unique
  createdAt         DateTime @default(now())

  invoice PlatformInvoice @relation(fields: [platformInvoiceId], references: [id], onDelete: Cascade)
}

enum PlatformSubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
}

enum PlatformPlanInterval {
  MONTHLY
  YEARLY
}

enum PlatformFeatureType {
  BOOLEAN
  NUMERIC
  TEXT
}


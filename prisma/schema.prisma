generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  employee
}

enum EmployeeType {
  Admin
  Manager
  Sales
  Technician
  Other
}

enum DealStage {
  LEAD
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum ServiceStage {
  ONBOARDING
  IN_PROGRESS
  UNDER_REVIEW
  COMPLETED
  CANCELLED
}

enum MessageSenderType {
  AGENT
  CLIENT
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ActivityType {
  NOTE
  CALL
  EMAIL
  MEETING
  TASK
}

enum ContactLifecycle {
  SUBSCRIBER
  LEAD
  PROSPECT
  CUSTOMER
  PARTNER
  CHURNED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  VOID
}

/// Workspace / tenant — every user belongs to one company.
model Company {
  id        Int      @id @default(autoincrement())
  name      String
  timezone  String   @default("UTC")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  users               User[]
  accounts            CrmAccount[]
  contacts            Contact[]
  deals               Deal[]
  activities          Activity[]
  products            Product[]
  invoices            Invoice[]
  chatMessages        ChatMessage[]
  serviceTickets      ServiceTicket[]
  clientConversations ClientConversation[]
}

model User {
  id               Int          @id @default(autoincrement())
  firstName        String
  lastName         String?
  email            String       @unique
  emailVerified    Boolean      @default(false) @map("email_verified")
  password         String
  image            String       @default("/images/default.png")
  phone            String?
  role             Role         @default(admin)
  employeeType     EmployeeType @default(Admin)
  isSuperAdmin     Boolean      @default(false) @map("is_super_admin")
  twoFactorEnabled Boolean      @default(false) @map("two_factor_enabled")
  companyId        Int          @map("company_id")
  timezone         String       @default("UTC")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @default(now()) @updatedAt @map("updated_at")

  company            Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  ownedDeals         Deal[]              @relation("DealOwner")
  activities         Activity[]
  chatMessages       ChatMessage[]
  ownedTickets       ServiceTicket[]     @relation("ServiceTicketOwner")
  passwordResetToken PasswordResetToken?

  @@index([companyId], name: "fk_users_company")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  token     String   @unique
  otp       String
  userId    Int      @unique @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Customer organization (sales account).
model CrmAccount {
  id          Int       @id @default(autoincrement())
  companyId   Int       @map("company_id")
  name        String
  website     String?
  industry    String?
  phone       String?
  address     String?
  city        String?
  state       String?
  country     String?
  postalCode  String?   @map("postal_code")
  employeeCount Int?    @map("employee_count")
  annualRevenue Decimal? @map("annual_revenue") @db.Decimal(14, 2)
  notes       String?
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")

  company             Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contacts            Contact[]
  deals               Deal[]
  activities          Activity[]
  invoices            Invoice[]
  serviceTickets      ServiceTicket[]
  clientConversations ClientConversation[]

  @@index([companyId])
  @@index([deletedAt])
}

model Contact {
  id          Int               @id @default(autoincrement())
  companyId   Int               @map("company_id")
  accountId   Int?              @map("account_id")
  firstName   String
  lastName    String?
  email       String?
  phone       String?
  title       String?
  lifecycle   ContactLifecycle  @default(LEAD)
  notes       String?
  deletedAt   DateTime?         @map("deleted_at")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @default(now()) @updatedAt @map("updated_at")

  company             Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  account             CrmAccount?          @relation(fields: [accountId], references: [id], onDelete: SetNull)
  deals               Deal[]
  activities          Activity[]
  serviceTickets      ServiceTicket[]
  clientConversations ClientConversation[]

  @@index([companyId])
  @@index([accountId])
  @@index([deletedAt])
}

model Deal {
  id                Int       @id @default(autoincrement())
  companyId         Int       @map("company_id")
  accountId         Int       @map("account_id")
  contactId         Int?      @map("contact_id")
  ownerId           Int       @map("owner_id")
  title             String
  description       String?
  source            String?
  value             Decimal?  @db.Decimal(12, 2)
  stage             DealStage @default(LEAD)
  probability       Int?      @default(0)
  lostReason        String?   @map("lost_reason")
  expectedCloseDate DateTime? @map("expected_close_date")
  closedAt          DateTime? @map("closed_at")
  deletedAt         DateTime? @map("deleted_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at")

  company    Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  account    CrmAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  contact    Contact?   @relation(fields: [contactId], references: [id], onDelete: SetNull)
  owner      User       @relation("DealOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  activities     Activity[]
  invoices       Invoice[]
  serviceTickets ServiceTicket[]

  @@index([companyId])
  @@index([accountId])
  @@index([ownerId])
  @@index([stage])
  @@index([deletedAt])
}

/// Sellable / stock item for invoicing and simple inventory control.
model Product {
  id          Int       @id @default(autoincrement())
  companyId   Int       @map("company_id")
  sku         String?
  name        String
  description String?
  unitPrice   Decimal   @default(0) @map("unit_price") @db.Decimal(12, 2)
  qtyOnHand   Int       @default(0) @map("qty_on_hand")
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")

  company   Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lineItems InvoiceLineItem[]

  @@index([companyId])
  @@index([deletedAt])
}

/// Customer bill linked to an account; optional deal for post-close billing.
model Invoice {
  id         Int           @id @default(autoincrement())
  companyId  Int           @map("company_id")
  accountId  Int           @map("account_id")
  dealId     Int?          @map("deal_id")
  number     String
  status     InvoiceStatus @default(DRAFT)
  issueDate  DateTime      @default(now()) @map("issue_date")
  dueDate    DateTime?     @map("due_date")
  taxPercent Int           @default(0) @map("tax_percent")
  notes      String?
  subtotal   Decimal       @default(0) @db.Decimal(14, 2)
  taxAmount  Decimal       @default(0) @map("tax_amount") @db.Decimal(14, 2)
  total      Decimal       @default(0) @db.Decimal(14, 2)
  deletedAt  DateTime?     @map("deleted_at")
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @default(now()) @updatedAt @map("updated_at")

  company Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  account CrmAccount    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  deal    Deal?         @relation(fields: [dealId], references: [id], onDelete: SetNull)
  lines   InvoiceLineItem[]

  @@unique([companyId, number])
  @@index([companyId])
  @@index([accountId])
  @@index([status])
  @@index([deletedAt])
}

model InvoiceLineItem {
  id          Int      @id @default(autoincrement())
  invoiceId   Int      @map("invoice_id")
  productId   Int?     @map("product_id")
  description String
  quantity    Int      @default(1)
  unitPrice   Decimal  @map("unit_price") @db.Decimal(12, 2)
  amount      Decimal  @db.Decimal(14, 2)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  invoice Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([productId])
}

/// Post-sale service delivery ticket (service pipeline).
model ServiceTicket {
  id          Int            @id @default(autoincrement())
  companyId   Int            @map("company_id")
  accountId   Int            @map("account_id")
  contactId   Int?           @map("contact_id")
  dealId      Int?           @map("deal_id")
  ownerId     Int            @map("owner_id")
  title       String
  description String?
  stage       ServiceStage   @default(ONBOARDING)
  priority    TicketPriority @default(MEDIUM)
  deletedAt   DateTime?      @map("deleted_at")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @default(now()) @updatedAt @map("updated_at")

  company Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  account CrmAccount  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  contact Contact?    @relation(fields: [contactId], references: [id], onDelete: SetNull)
  deal    Deal?        @relation(fields: [dealId], references: [id], onDelete: SetNull)
  owner   User         @relation("ServiceTicketOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([accountId])
  @@index([stage])
  @@index([deletedAt])
}

/// Chat thread between team and a client (contact/account).
model ClientConversation {
  id        Int      @id @default(autoincrement())
  companyId Int      @map("company_id")
  accountId Int      @map("account_id")
  contactId Int?     @map("contact_id")
  token     String   @unique
  title     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  company  Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  account  CrmAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  contact  Contact?   @relation(fields: [contactId], references: [id], onDelete: SetNull)
  messages ClientMessage[]

  @@index([companyId])
  @@index([token])
}

/// Message in a client conversation.
model ClientMessage {
  id             Int               @id @default(autoincrement())
  conversationId Int               @map("conversation_id")
  senderType     MessageSenderType
  senderName     String            @map("sender_name")
  content        String
  createdAt      DateTime          @default(now()) @map("created_at")

  conversation ClientConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

/// Internal workspace chat messages.
model ChatMessage {
  id        Int      @id @default(autoincrement())
  companyId Int      @map("company_id")
  senderId  Int      @map("sender_id")
  roomId    String   @map("room_id")
  content   String
  createdAt DateTime @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sender  User    @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([companyId, roomId])
  @@index([senderId])
}

model Activity {
  id          Int          @id @default(autoincrement())
  companyId   Int          @map("company_id")
  userId      Int          @map("user_id")
  type        ActivityType
  subject     String
  body        String?
  dueAt       DateTime?    @map("due_at")
  completedAt DateTime?    @map("completed_at")
  dealId      Int?         @map("deal_id")
  contactId   Int?         @map("contact_id")
  accountId   Int?         @map("account_id")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @default(now()) @updatedAt @map("updated_at")

  company Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  deal    Deal?       @relation(fields: [dealId], references: [id], onDelete: SetNull)
  contact Contact?    @relation(fields: [contactId], references: [id], onDelete: SetNull)
  account CrmAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([userId])
  @@index([dealId])
}

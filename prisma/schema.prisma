  serviceMaintenanceStageForRules  ServiceMaintenanceAutomationRule[] @relation("conditionColumn")
  invoiceAutomationRule            InvoiceAutomationRule[]            @relation("invoiceStatus")
  InvoiceAutomationRule            InvoiceAutomationRule[]
  // tagAutomationRuleColumns         TagAutomationRule[]
  postTagAutomationColumns         PostTagAutomationColumn[]
  tagAutomationPipeline            TagAutomationPipeline[]
  invoiceTemplates                 InvoiceTemplate[]

  @@index([companyId])
  @@index([type])
  @@index([type, companyId])

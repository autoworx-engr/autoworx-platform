// 1. The Global Shop Booking Settings
model ShopBookingSetting {
  id     Int @id @default(autoincrement())
  shopId Int @unique @map("shop_id")

  // Deposit Settings (from previous step)
  isDepositEnabled Boolean      @default(false) @map("is_deposit_enabled")
  depositType      DepositType? @default(FIXED) @map("deposit_type")
  depositValue     Decimal?     @map("deposit_value") @db.Decimal(10, 2)

  // Appointment Logic (from the top of your new UI image)
  isStackingEnabled Boolean @default(false) @map("is_stacking_enabled")
  stackingLimit     Int     @default(1) @map("stacking_limit")
  slotInterval      Int     @default(30) @map("slot_interval")

  // tax enabled
  isTaxEnabled        Boolean @default(false) @map("is_tax_enabled")
  isServiceFeeEnabled Boolean @default(false) @map("is_service_fee_enabled")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  shop           Shop               @relation(fields: [shopId], references: [id], onDelete: Cascade)
  availabilities ShopAvailability[] // <-- Links to the 7 days of the week

  @@map("shop_booking_settings")
}

// 1. Enum for the Deposit Type
enum DepositType {
  FIXED
  PERCENTAGE
}

// 2. NEW: Day-by-Day Availability (Maps perfectly to your UI grid)
model ShopAvailability {
  id                   Int @id @default(autoincrement())
  shopBookingSettingId Int @map("shop_booking_setting_id")

  dayOfWeek DayOfWeek @map("day_of_week") // MONDAY, TUESDAY, etc.

  // The toggle switch (e.g., Sunday is false)
  isOpen Boolean @default(true) @map("is_open")

  // The time inputs (Store these in 24-hour format like "08:00" and "16:00" for easier backend math)
  startTime String? @map("start_time")
  endTime   String? @map("end_time")

  // Relation back to the main settings
  setting ShopBookingSetting @relation(fields: [shopBookingSettingId], references: [id], onDelete: Cascade)

  // Ensure a shop can only have one configuration per day (e.g., only one "Monday" record per shop)
  @@unique([shopBookingSettingId, dayOfWeek])
  @@map("shop_availabilities")
}

// NEW: Virtual Shop Booking Models

model ShopBooking {
  id       Int  @id @default(autoincrement())
  shopId   Int  @map("shop_id")
  clientId Int? @map("client_id") // Optional if guest checkout is allowed

  // Vehicle Info
  vehicleId Int? @map("vehicle_id")

  // Appointment — created on confirmation when deposit is required
  appointmentId   Int?    @unique @map("appointment_id")
  appointmentDate String? @map("appointment_date")
  appointmentTime String? @map("appointment_time")

  // Invoice — created on confirmation when deposit is required
  invoiceId String?  @unique @map("invoice_id")
  invoice   Invoice? @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  // Status
  status ShopBookingStatus @default(PENDING)

  // Deposit tracking (stored at creation so confirmation can validate)
  depositRequired     Decimal? @map("deposit_required") @db.Decimal(10, 2)
  pendingGiftCardCode String?  @map("pending_gift_card_code") @db.VarChar(100)

  // Notes
  customerNotes String? @map("customer_notes") @db.Text
  internalNotes String? @map("internal_notes") @db.Text

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  shop        Shop                 @relation(fields: [shopId], references: [id], onDelete: Cascade)
  client      Client?              @relation(fields: [clientId], references: [id], onDelete: SetNull)
  services    ShopBookingService[]
  vehicle     Vehicle?             @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  appointment Appointment?         @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([shopId])
  @@index([clientId])
  @@index([appointmentId])
  @@index([vehicleId])
  @@map("shop_bookings")
}


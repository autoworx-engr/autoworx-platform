enum GiftCardPurchaseType {
  INDIVIDUAL
  MULTIPLE_RECIPIENTS
  GROUP_GIFT
}

model GiftCardTransaction {
  id         Int @id @default(autoincrement())
  giftCardId Int @map("gift_card_id")

  // The Financial Math
  type         TransactionType
  amount       Decimal         @db.Decimal(10, 2) // Positive for reloads, Negative for redemptions
  balanceAfter Decimal         @map("balance_after") @db.Decimal(10, 2)

  // Traceability
  referenceId String? @map("reference_id") // Can store an Invoice ID, Order ID, or Stripe Payment ID
  notes       String? @db.Text

  createdAt DateTime @default(now()) @map("created_at")

  giftCard IssuedGiftCard @relation(fields: [giftCardId], references: [id], onDelete: Cascade)

  @@index([giftCardId])
  @@map("gift_card_transactions")
}

enum GiftCardStatus {
  ACTIVE
  DEPLETED // Balance is 0, but can be reloaded
  EXPIRED
  FROZEN // Suspended for fraud/issues
}

enum TransactionType {
  ISSUE // Initial card creation
  REDEMPTION // Used to pay for a service
  RELOAD // Purchaser added more money
  REFUND // Service was cancelled, money returned to card
}

// }

model ShopSlotHold {
  id           Int      @id @default(autoincrement())
  shopId       Int      @map("shop_id")
  sessionToken String   @map("session_token")
  date         DateTime
  startTime    String   @map("start_time")
  endTime      String   @map("end_time")
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([shopId, date, expiresAt])
}

// ─────────────────────────────────────────────────────────────
// Meta / Facebook Messenger Integration
// ─────────────────────────────────────────────────────────────

enum MessengerMessageSentBy {
  Client
  Company
}

// One record per connected Facebook Page per company.
model FacebookPage {
  id                Int      @id @default(autoincrement())
  companyId         Int      @map("company_id")
  pageId            String   @map("page_id")
  pageName          String   @map("page_name")
  pageAccessToken   String   @map("page_access_token") @db.Text
  pictureUrl        String?  @map("picture_url")
  isActive          Boolean  @default(true) @map("is_active")
  webhookSubscribed Boolean  @default(false) @map("webhook_subscribed")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at")

  company        Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  messages       MessengerMessage[]
  clientProfiles FacebookClientProfile[]

  @@unique([companyId, pageId])
  @@index([companyId])
  @@index([pageId])
  @@map("facebook_pages")
}

// Maps a Facebook Page-Scoped User ID (PSID) to a platform Client.
// A PSID is unique per user per page, so we key on (facebookPageId, psid).
model FacebookClientProfile {
  id             Int      @id @default(autoincrement())
  clientId       Int      @map("client_id")
  facebookPageId Int      @map("facebook_page_id")
  psid           String
  createdAt      DateTime @default(now()) @map("created_at")

  client       Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  facebookPage FacebookPage @relation(fields: [facebookPageId], references: [id], onDelete: Cascade)

  @@unique([facebookPageId, psid])
  @@index([clientId])
  @@map("facebook_client_profiles")
}

// Individual Messenger message (inbound from client or outbound from company).
model MessengerMessage {
  id             Int                    @id @default(autoincrement())
  companyId      Int                    @map("company_id")
  clientId       Int                    @map("client_id")
  facebookPageId Int                    @map("facebook_page_id")
  mid            String? // Meta message ID for dedup
  message        String?                @db.Text
  sentBy         MessengerMessageSentBy
  isRead         Boolean                @default(false) @map("is_read")
  userId         Int?                   @map("user_id")
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @default(now()) @updatedAt @map("updated_at")

  company      Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client       Client                @relation(fields: [clientId], references: [id], onDelete: Cascade)
  facebookPage FacebookPage          @relation(fields: [facebookPageId], references: [id], onDelete: Cascade)
  user         User?                 @relation(fields: [userId], references: [id])
  attachments  MessengerAttachment[]

  @@index([companyId, clientId])
  @@index([clientId])
  @@index([facebookPageId])
  @@map("messenger_messages")
}

// Media attachments sent/received through Messenger.
model MessengerAttachment {
  id                 Int      @id @default(autoincrement())
  messengerMessageId Int      @map("messenger_message_id")
  url                String   @db.Text
  name               String?
  attachmentType     String   @map("attachment_type") // image | video | audio | file
  createdAt          DateTime @default(now()) @map("created_at")

  messengerMessage MessengerMessage @relation(fields: [messengerMessageId], references: [id], onDelete: Cascade)

  @@index([messengerMessageId])
  @@map("messenger_attachments")
}

// Emergency Booking Request Model
model EmergencyBookingRequest {
  id       Int  @id @default(autoincrement())
  shopId   Int  @map("shop_id")
  clientId Int? @map("client_id")

  // Contact Information (in case client is guest)
  contactName  String @map("contact_name") @db.VarChar(255)
  contactEmail String @map("contact_email") @db.VarChar(255)
  contactPhone String @map("contact_phone") @db.VarChar(50)

  // Emergency Details
  description String @db.Text

  // Requested Time (user preference)
  requestedDate  String? @map("requested_date") // User's preferred date
  requestedTime  String? @map("requested_time") // User's preferred time
  flexibleTiming Boolean @default(true) @map("flexible_timing") // Can they be flexible?

  // Vehicle Info
  vehicleId    Int?    @map("vehicle_id")
  vehicleMake  String? @map("vehicle_make") @db.VarChar(100)
  vehicleModel String? @map("vehicle_model") @db.VarChar(100)
  vehicleYear  Int?    @map("vehicle_year")

  // Services Requested (stored as JSON for flexibility)
  requestedServices Json @map("requested_services") // Array of service IDs or descriptions

  // Status & Resolution
  status   EmergencyRequestStatus @default(PENDING)
  priority Int                    @default(5) // 1-10, higher = more urgent

  // Admin Response
  reviewedBy      Int?      @map("reviewed_by")
  reviewedAt      DateTime? @map("reviewed_at")
  adminNotes      String?   @map("admin_notes") @db.Text
  rejectionReason String?   @map("rejection_reason") @db.Text

  // Proposed Alternative (if original time not available)
  proposedDate     String? @map("proposed_date")
  proposedTime     String? @map("proposed_time")
  alternativeNotes String? @map("alternative_notes") @db.Text

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  expiresAt DateTime @map("expires_at") // Auto-expire if not reviewed within X hours

  // Relations
  shop     Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  client   Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  vehicle  Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  reviewer User?    @relation("EmergencyReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@index([shopId, status])
  @@index([shopId, createdAt])
  @@index([priority])
  @@index([expiresAt])
  @@map("emergency_booking_requests")
}

enum EmergencyRequestStatus {
  PENDING // Waiting for admin review
  UNDER_REVIEW // Admin is actively reviewing
  APPROVED // Admin approved, booking created
  ALTERNATIVE_PROPOSED // Admin proposed different time
  CLIENT_CONFIRMED // Client confirmed alternative time
  REJECTED // Cannot accommodate
  EXPIRED // Not reviewed within time window
  CANCELLED // Client cancelled the request
}

// ── Instagram DM ──────────────────────────────────────────────────────────────

model InstagramAccount {
  id                Int                      @id @default(autoincrement())
  companyId         Int                      @map("company_id")
  igUserId          String                   @map("ig_user_id")
  username          String?
  pageAccessToken   String                   @map("page_access_token")
  facebookPageId    String?                  @map("facebook_page_id")
  pictureUrl        String?                  @map("picture_url")
  isActive          Boolean                  @default(true)  @map("is_active")
  webhookSubscribed Boolean                  @default(false) @map("webhook_subscribed")
  createdAt         DateTime                 @default(now()) @map("created_at")
  updatedAt         DateTime                 @default(now()) @updatedAt @map("updated_at")
  company           Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  clientProfiles    InstagramClientProfile[]
  messages          InstagramMessage[]

  @@unique([companyId, igUserId], name: "companyId_igUserId")
  @@map("instagram_accounts")
}

model InstagramClientProfile {
  id          Int              @id @default(autoincrement())
  igAccountId Int              @map("ig_account_id")
  igsid       String
  clientId    Int              @map("client_id")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @default(now()) @updatedAt @map("updated_at")
  igAccount   InstagramAccount @relation(fields: [igAccountId], references: [id], onDelete: Cascade)
  client      Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([igAccountId, igsid], name: "igAccountId_igsid")
  @@map("instagram_client_profiles")
}

model InstagramMessage {
  id          Int                          @id @default(autoincrement())
  companyId   Int                          @map("company_id")
  clientId    Int                          @map("client_id")
  igAccountId Int                          @map("ig_account_id")
  mid         String?                      @unique
  message     String?                      @db.Text
  sentBy      String                       @map("sent_by")
  isRead      Boolean                      @default(false) @map("is_read")
  userId      Int?                         @map("user_id")
  createdAt   DateTime                     @default(now()) @map("created_at")
  updatedAt   DateTime                     @default(now()) @updatedAt @map("updated_at")
  company     Company                      @relation(fields: [companyId], references: [id])
  client      Client                       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  igAccount   InstagramAccount             @relation(fields: [igAccountId], references: [id])
  user        User?                        @relation(fields: [userId], references: [id], onDelete: SetNull)
  attachments InstagramMessageAttachment[]

  @@index([companyId, clientId])
  @@map("instagram_messages")
}

model InstagramMessageAttachment {
  id             Int              @id @default(autoincrement())
  messageId      Int              @map("message_id")
  url            String
  name           String?
  attachmentType String           @map("attachment_type")
  message        InstagramMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@map("instagram_message_attachments")
}

// Mobile app version management — controls soft/force update behavior
model AppVersion {
  id                  Int      @id @default(autoincrement())
  latestVersion       String   @map("latest_version")
  minSupportedVersion String   @map("min_supported_version")
  forceUpdate         Boolean  @default(false) @map("force_update")
  message             String?
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("app_versions")
}

/// Global SMS test settings (single row). `allowlist` is a comma-separated
/// string of test-safe recipient numbers. While an SMS send is restricted
/// (non-production runtime, or a Company.isTest account in prod), only numbers
/// in this string are actually delivered. See outboundSmsGuard.ts.
model SmsTestConfig {
  id        Int      @id @default(autoincrement())
  allowlist String   @default("+18788797134,+16783739090,+14702560094") @db.Text
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("sms_test_config")
}

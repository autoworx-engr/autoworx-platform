generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Appointment {
  id                              Int                             @id @default(autoincrement())
  userId                          Int                             @map("user_id")
  title                           String                          @db.VarChar(100)
  date                            DateTime?
  startTime                       String?                         @map("start_time")
  endTime                         String?                         @map("end_time")
  companyId                       Int                             @map("company_id")
  clientId                        Int?                            @map("customer_id")
  vehicleId                       Int?                            @map("vehicle_id")
  draftEstimate                   String?                         @map("draft_estimate")
  notes                           String?
  confirmationEmailTemplateId     Int?              @map("confirmation_email_template_id")
  confirmationEmailTemplateStatus Boolean           @default(false) @map("confirmation_email_template_status")
  reminderEmailTemplateId         Int?              @map("reminder_email_template_id")
  reminderEmailTemplateStatus     Boolean           @default(false) @map("reminder_email_template_status")
  times                           Json? // { time: string; date: string }
  createdAt                       DateTime          @default(now()) @map("created_at")
  updatedAt                       DateTime          @default(now()) @updatedAt @map("updated_at")
  user                            User              @relation(fields: [userId], references: [id])
  company                         Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  appointmentUsers                AppointmentUser[]
  client                          Client?           @relation(fields: [clientId], references: [id])
  vehicle                         Vehicle?          @relation(fields: [vehicleId], references: [id])
  googleEventId                   String?
  timezone                        String?

  @@index([userId], name: "fk_tasks_user")
  @@index([companyId], name: "fk_tasks_company")
  @@index([clientId], name: "fk_tasks_client")
  @@index([date])
  @@index([service_category_id])
}

model AppointmentUser {
  id            Int         @id @default(autoincrement())
  appointmentId Int         @map("appointment_id")
  userId        Int         @map("user_id")
  eventId       String      @db.VarChar(100)
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @default(now()) @updatedAt @map("updated_at")
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([appointmentId])
}

model AppointmentTitle {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(100)
  companyId Int      @map("company_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("appointment_titles")
}

model BookingForm {
  id          Int      @id @default(autoincrement())
  title       String?  @db.VarChar(200)
  description String?  @db.VarChar(500)
  companyId   Int      @map("company_id")
  bookingUrl  String   @map("booking_url")
  qrCodeUrl   String   @map("qr_code_url")
  stack       Int      @default(1)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")
}

model PipelineAutomationRule {
  id                  Int                  @id @default(autoincrement())
  title               String
  conditionType       ConditionType
  targetColumnId      Int?
  isPaused            Boolean              @default(false)
  timeDelay           Int?
  companyId           Int
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  company             Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  targetColumn        Column?              @relation("targetColumn", fields: [targetColumnId], references: [id])
  stages              PipelineStage[]
  timeDelayExecutions TimeDelayExecution[]

  @@index([companyId])
}

model PipelineStage {
  id             Int                    @id @default(autoincrement())
  pipelineRuleId Int
  columnId       Int
  column         Column                 @relation(fields: [columnId], references: [id], onDelete: Cascade)
  pipelineRule   PipelineAutomationRule @relation(fields: [pipelineRuleId], references: [id], onDelete: Cascade)

  @@unique([pipelineRuleId, columnId])
  @@index([pipelineRuleId])
}

model TimeDelayExecution {
  id                        Int                               @id @default(autoincrement())
  pipelineRuleId            Int?
  communicationRuleId       Int?
  leadId                    Int?
  estimateId                String?
  serviceMaintenanceRuleId  Int?
  invoiceAutomationRuleId   Int?
  executeAt                 DateTime
  status                    ExecutionStatus                   @default(PENDING)
  jobId                     String?
  createdAt                 DateTime                          @default(now())
  updatedAt                 DateTime                          @updatedAt
  columnId                  Int?
  inventoryAutomationRuleId Int?
  tagAutomationRuleId       Int?
  column                    Column?                           @relation(fields: [columnId], references: [id])
  communicationRule         CommunicationAutomationRule?      @relation(fields: [communicationRuleId], references: [id])
  estimate                  Invoice?                          @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  InventoryAutomationRule   InventoryAutomationRule?          @relation(fields: [inventoryAutomationRuleId], references: [id])
  InvoiceAutomationRule     InvoiceAutomationRule?            @relation(fields: [invoiceAutomationRuleId], references: [id])
  lead                      Lead?                             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  pipelineRule              PipelineAutomationRule?           @relation(fields: [pipelineRuleId], references: [id])
  serviceMaintenanceRule    ServiceMaintenanceAutomationRule? @relation(fields: [serviceMaintenanceRuleId], references: [id])
  tagAutomationRule         TagAutomationRule?                @relation(fields: [tagAutomationRuleId], references: [id])

  @@index([executeAt, status])
  @@index([pipelineRuleId])
  @@index([communicationRuleId])
  @@index([leadId])
}

model CommunicationAutomationRule {
  id                 Int                    @id @default(autoincrement())
  companyId          Int
  title              String
  timeDelay          Int
  targetColumnId     Int?
  communicationType  CommunicationType
  isSendWeekDays     Boolean                @default(false)
  isSendOfficeHours  Boolean                @default(false)
  templateType       TemplateType
  subject            String?
  emailBody          String?
  smsBody            String?
  isPaused           Boolean                @default(false)
  createdBy          String?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  attachments        AutomationAttachment[] @relation("CommunicationAttachments")
  targetColumn       Column?                @relation("targetColumn", fields: [targetColumnId], references: [id])
  stages             CommunicationStage[]
  timeDelayExecution TimeDelayExecution[]
}

model CommunicationStage {
  id                  Int                         @id @default(autoincrement())
  communicationRuleId Int
  columnId            Int
  column              Column                      @relation(fields: [columnId], references: [id], onDelete: Cascade)
  communicationRule   CommunicationAutomationRule @relation(fields: [communicationRuleId], references: [id], onDelete: Cascade)

  @@unique([communicationRuleId, columnId])
  @@index([communicationRuleId])
}

model MarketingAutomationRule {
  id                   Int                    @id @default(autoincrement())
  companyId            Int
  target               Json
  targetCondition      TargetCondition
  date                 DateTime
  startTime            DateTime
  isAppointmentCreated Boolean                @default(false)
  vehicleMinYear       String?
  vehicleMaxYear       String?
  vehicleBrand         String?
  vehicleModel         String?
  communicationType    CommunicationType
  emailSubject         String?
  emailBody            String?
  smsBody              String?
  isPaused             Boolean                @default(false)
  createdBy            String
  isActive             Boolean                @default(true)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  attachments          AutomationAttachment[] @relation("MarketingAttachments")
}

model ServiceMaintenanceAutomationRule {
  id                      Int                       @id @default(autoincrement())
  companyId               Int
  title                   String
  conditionColumnId       Int
  isPaused                Boolean                   @default(false)
  timeDelay               Int?
  targetColumnId          Int?
  templateType            TemplateType              @default(SMS)
  emailSubject            String?
  emailBody               String?
  smsBody                 String?
  createdBy               String?
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  attachments             AutomationAttachment[]    @relation("ServiceMaintenanceAttachments")
  company                 Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  conditionColumn         Column                    @relation("conditionColumn", fields: [conditionColumnId], references: [id])
  targetColumn            Column?                   @relation("targetColumn", fields: [targetColumnId], references: [id])
  serviceMaintenanceStage ServiceMaintenanceStage[]
  timeDelayExecution      TimeDelayExecution[]
}

model ServiceMaintenanceStage {
  id                       Int                              @id @default(autoincrement())
  serviceMaintenanceRuleId Int
  serviceId                Int
  columnId                 Int?
  service                  Service                          @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  serviceMaintenanceRule   ServiceMaintenanceAutomationRule @relation(fields: [serviceMaintenanceRuleId], references: [id], onDelete: Cascade)

  @@unique([serviceMaintenanceRuleId, serviceId])
  @@index([serviceMaintenanceRuleId])
}

model InvoiceAutomationRule {
  id                 Int                    @id @default(autoincrement())
  title              String
  companyId          Int
  type               InvoiceType            @default(Invoice)
  invoiceStatusId    Int
  timeDelay          String?
  isPaused           Boolean                @default(false)
  communicationType  CommunicationType
  emailBody          String?
  smsBody            String?
  emailSubject       String?
  createdBy          String?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  columnId           Int?
  attachments        AutomationAttachment[] @relation("InvoiceAttachments")
  Column             Column?                @relation(fields: [columnId], references: [id])
  company            Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoiceStatus      Column                 @relation("invoiceStatus", fields: [invoiceStatusId], references: [id])
  timeDelayExecution TimeDelayExecution[]
}

model AutomationAttachment {
  id                   Int                               @id @default(autoincrement())
  fileUrl              String
  communicationId      Int?
  marketingId          Int?
  serviceMaintenanceId Int?
  invoiceId            Int?
  createdAt            DateTime                          @default(now())
  updatedAt            DateTime                          @updatedAt
  tagCommunicationId   Int?
  communication        CommunicationAutomationRule?      @relation("CommunicationAttachments", fields: [communicationId], references: [id])
  invoice              InvoiceAutomationRule?            @relation("InvoiceAttachments", fields: [invoiceId], references: [id])
  marketing            MarketingAutomationRule?          @relation("MarketingAttachments", fields: [marketingId], references: [id])
  serviceMaintenance   ServiceMaintenanceAutomationRule? @relation("ServiceMaintenanceAttachments", fields: [serviceMaintenanceId], references: [id])
  tagCommunication     TagAutomationCommunication?       @relation("TagAutomationCommunicationAttachments", fields: [tagCommunicationId], references: [id])
}

model InventoryAutomationRule {
  id                 Int                             @id @default(autoincrement())
  title              String
  companyId          Int
  frequency          InventoryAutomationFrequency
  day                DayOfWeek?
  condition          InventoryCondition
  action             InventoryNotificationAction
  isPaused           Boolean                         @default(false)
  createdBy          String?
  createdAt          DateTime                        @default(now())
  updatedAt          DateTime                        @updatedAt
  company            Company                         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  teamMembers        InventoryAutomationTeamMember[]
  timeDelayExecution TimeDelayExecution[]

  @@index([companyId])
}

model InventoryAutomationTeamMember {
  inventoryRuleId Int
  userId          Int
  inventoryRule   InventoryAutomationRule @relation(fields: [inventoryRuleId], references: [id], onDelete: Cascade)
  user            User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([inventoryRuleId, userId])
}

model ReportingAutomationRule {
  id          Int                             @id @default(autoincrement())
  title       String
  companyId   Int
  frequency   ReportingAutomationFrequency
  action      ReportingNotificationAction
  day         DayOfWeek?
  isPaused    Boolean                         @default(false)
  createdBy   String?
  createdAt   DateTime                        @default(now())
  updatedAt   DateTime                        @updatedAt
  company     Company                         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  teamMembers ReportingAutomationTeamMember[]

  @@index([companyId])
}
model ReportingAutomationTeamMember {
  reportingRuleId Int
  userId          Int
  reportingRule   ReportingAutomationRule @relation(fields: [reportingRuleId], references: [id], onDelete: Cascade)
  user            User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([reportingRuleId, userId])
}

model ReportingAutomationRule {
  id          Int                             @id @default(autoincrement())
  title       String
  companyId   Int
  frequency   ReportingAutomationFrequency
  action      ReportingNotificationAction
  day         DayOfWeek?
  isPaused    Boolean                         @default(false)
  createdBy   String?
  createdAt   DateTime                        @default(now())
  updatedAt   DateTime                        @updatedAt
  company     Company                         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  teamMembers ReportingAutomationTeamMember[]

  @@index([companyId])
}

model ReportingAutomationTeamMember {
  reportingRuleId Int
  userId          Int
  reportingRule   ReportingAutomationRule @relation(fields: [reportingRuleId], references: [id], onDelete: Cascade)
  user            User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([reportingRuleId, userId])
}

model TagAutomationRule {
  id                         Int                         @id @default(autoincrement())
  companyId                  Int
  title                      String
  timeDelay                  Int                         @default(0)
  isPaused                   Boolean                     @default(false)
  condition_type             TagConditionType
  pipelineType               PipelineType
  ruleType                   TagRuleType?
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @default(now()) @updatedAt
  PostTagAutomationColumn    PostTagAutomationColumn?
  tagAutomationCommunication TagAutomationCommunication?
  tagAutomationPipeline      TagAutomationPipeline?
  timeDelayExecution         TimeDelayExecution[]
  tag                        Tag[]                       @relation("TagToTagAutomationRule")
}

model TagAutomationPipeline {
  id              Int               @id @default(autoincrement())
  tagAutomationId Int               @unique
  targetColumnId  Int
  tagAutomation   TagAutomationRule @relation(fields: [tagAutomationId], references: [id], onDelete: Cascade)
  column          Column            @relation(fields: [targetColumnId], references: [id], onDelete: Cascade)

  @@index([tagAutomationId])
}

model TagAutomationCommunication {
  id                Int                    @id @default(autoincrement())
  tagAutomationId   Int                    @unique
  communicationType CommunicationType
  isSendWeekDays    Boolean                @default(false)
  isSendOfficeHours Boolean                @default(false)
  subject           String?
  emailBody         String?
  smsBody           String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  attachments       AutomationAttachment[] @relation("TagAutomationCommunicationAttachments")
  tagAutomation     TagAutomationRule      @relation(fields: [tagAutomationId], references: [id], onDelete: Cascade)

  @@index([tagAutomationId])
}

model PostTagAutomationColumn {
  id              Int               @id @default(autoincrement())
  tagAutomationId Int               @unique
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @default(now()) @updatedAt
  tagAutomation   TagAutomationRule @relation(fields: [tagAutomationId], references: [id], onDelete: Cascade)
  columnIds       Column[]          @relation("ColumnToPostTagAutomationColumn")

  @@index([tagAutomationId])
}

enum TagRuleType {
  one_time
  recurring
}

enum TagConditionType {
  pipeline
  communication
  post_tag
}

enum PipelineType {
  SALES
  SHOP
}

// Enums
enum CommunicationType {
  SMS
  EMAIL
  BOTH
}

enum TemplateType {
  SMS
  EMAIL
}

enum MarketingTarget {
  ALL_CLIENTS
  WITH_ESTIMATE
  WITH_INVOICE
  WITHOUT_AN_ESTIMATE
  INVOICE
}

enum TargetCondition {
  ALL_CLIENTS_THIS_MONTH
  ALL_CLIENTS_THIS_YEAR
  ALL_CLIENTS_FROM_1_MONTH
  ALL_CLIENTS_FROM_2_MONTHS
  ALL_CLIENTS_FROM_3_MONTHS
  ALL_CLIENTS_FROM_6_MONTHS
  ALL_CLIENTS_FROM_LAST_YEAR
}

enum ConditionType {
  APPOINTMENT_SCHEDULED
  ESTIMATE_CREATED
  TASK_CREATED
  MESSAGE_SENT_CLIENT
  MESSAGE_RECEIVED_CLIENT
  TIME_DELAY
}

enum ExecutionStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

enum InventoryAutomationFrequency {
  DAILY
  WEEKLY
  MONTHLY
  EVERY_TWO_MONTHS
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum InventoryCondition {
  LOW_STOCK
  OUT_OF_STOCK
  BOTH
}

enum InventoryNotificationAction {
  EMAIL
  SMS
  BOTH
}

// Client of a company.
// Client is just data, they can't login.
model Client {
  id                     Int                      @id @default(autoincrement())
  firstName              String                   @map("first_name")
  lastName               String?                  @map("last_name")
  mobile                 String?
  email                  String?
  address                String?
  city                   String?
  state                  String?
  zip                    String?
  isFleet                Boolean?                 @default(false) @map("is_fleet")
  photo                  String                   @default("/images/default.png")
  fromRequest            Boolean?                 @default(false) @map("from_request")
  fromRequestedCompanyId Int?                     @map("from_requested_company_id")
  sourceId               Int?                     @map("source_id")
  converted              Boolean?                 @default(false) @map("converted")
  companyId              Int                      @map("company_id")
  createdAt              DateTime                 @default(now()) @map("created_at")
  updatedAt              DateTime                 @default(now()) @updatedAt @map("updated_at")
  customerCompany        String?                  @map("customer_company")
  tagId                  Int?                     @map("tag_id")
  notes                  String?
  leadId                 Int?
  firstContactTime       DateTime?
  lastMailgunEmailReadId Int?
  isStarred              Boolean?                 @default(false)
  countryCode            String?                  @default("US") @map("country_code")
  isSalesAgent           Boolean                  @default(true)
  appointments           Appointment[]
  company                Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  Lead                   Lead?                    @relation(fields: [leadId], references: [id])
  source                 Source?                  @relation(fields: [sourceId], references: [id])
  tag                    Tag?                     @relation(fields: [tagId], references: [id])
  ClientCall             ClientCall[]
  conversationsTrack     ClientConversationTrack?
  ClientCoupon           ClientCoupon[]
  ClientSMS              ClientSMS[]
  fleet                  Fleet?

  @@index([companyId], map: "fk_customers_company")
  @@map("Client")
}

model Fleet {
  id                   Int              @id @default(autoincrement())
  clientId             Int              @unique @map("client_id")
  fleetName            String
  contactName          String
  preferredPaymentTerm String?          @map("preferred_payment_term")
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @default(now()) @updatedAt @map("updated_at")
  client               Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  statement            FleetStatement[]
}

model FleetStatement {
  id        String    @id @default(cuid())
  fleetId   Int       @map("fleet_id")
  Fleet     Fleet     @relation(fields: [fleetId], references: [id])
  invoice   Invoice[]
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")
  Fleet     Fleet     @relation(fields: [fleetId], references: [id], onDelete: Cascade)
  invoice   Invoice[]
}

model Source {
  id        Int      @id @default(autoincrement())
  name      String
  companyId Int      @map("company_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  Client    Client[]
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model ClientCoupon {
  id        Int      @id @default(autoincrement())
  couponId  Int      @map("coupon_id")
  clientId  Int      @map("client_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
}

model ClientConversationTrack {
  id                 Int       @id @default(autoincrement())
  clientId           Int       @unique @map("client_id")
  emailIsRead        Boolean   @default(true) @map("email_is_read")
  smsIsRead          Boolean   @default(true) @map("sms_is_read")
  emailIsUnReadCount Int       @default(0) @map("email_is_unread_count")
  smsUnReadCount     Int       @default(0) @map("sms_unread_count")
  emailLastMessage   String?   @map("email_last_message")
  smsLastMessage     String?   @map("sms_last_message")
  lastMessageBy      String?   @map("last_message_by")
  lastEmailBy        String?   @map("last_email_by")
  sendAt             DateTime? @map("send_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at")
  client             Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model Company {
  id                               Int                                @id @default(autoincrement())
  name                             String
  businessId                       String?                            @map("business_id")
  businessType                     String?                            @map("business_type")
  phone                            String?
  email                            String?
  industry                         String?
  website                          String?
  address                          String?
  about                            String?
  teamSize                         TeamSize?                          @default(MEDIUM)
  city                             String?
  state                            String?
  zip                              String?
  image                            String?
  businessVisibility               Boolean?                           @default(true) @map("business_visibility")
  phoneVisibility                  Boolean?                           @default(true) @map("phone_visibility")
  addressVisibility                Boolean?                           @default(true) @map("address_visibility")
  tax                              Decimal?                           @default(0)
  serviceFee                       Decimal?                           @default(0)
  currency                         String?                            @default("USD")
  terms                            String?                            @db.VarChar(800)
  policy                           String?                            @db.VarChar(800)
  leadTerms                        String?                            @map("lead_terms")
  leadPolicy                       String?                            @map("lead_policy")
  googleEmail                      String?                            @map("google_email")
  googleRefreshToken               String?                            @map("google_refresh_token")
  googleCalendarToken              String?                            @map("google_calendar_token")
  isSalesAgent                     Boolean                            @default(true)
  createdAt                        DateTime                           @default(now()) @map("created_at")
  updatedAt                        DateTime                           @default(now()) @updatedAt @map("updated_at")
  companyLatitude                  Float?
  companyLongitude                 Float?
  zapierToken                      String?                            @unique @db.VarChar(240)
  isCRMEnabled                     Boolean?                           @default(false) @map("is_crm_enabled")
  twilioCredentialsId              Int?
  mailgunCredentialId              Int?
  stripeAccountId                  String?
  timezone                         String?
  smsGateway                       SmsGateway                         @default(TWILIO)
  countryCode                      String?                            @default("US") @map("country_code")
  isCollaborators                  Boolean?                           @default(false) @map("is_collaborators")
  callForwardingNumber             String?                            @map("call_forwarding_number")
  googleReviewLink                 String?                            @map("google_review_link") @db.VarChar(500)
  authorizeNetApiLoginId           String?                            @map("authorize_net_api_login_id")
  authorizeNetTransactionKey       String?                            @map("authorize_net_transaction_key")
  paymentGateway                   PaymentGateway                     @default(STRIPE)
  callWhisperEnabled               Boolean                            @default(true) @map("call_whisper_enabled")
  isSalesAgent                     Boolean                            @default(true)
  about                            String?
  enforcePlatformPlan              Boolean                            @default(false) @map("enforce_platform_plan")
  missedCallTextBackEnabled        Boolean                            @default(true) @map("missed_call_text_back_enabled")
  teamSize                         TeamSize?                          @default(MEDIUM)
  appointments                     Appointment[]
  BugReport                        BugReport[]
  calendarSettings                 CalendarSettings?
  categories                       Category[]
  clients                          Client[]
  ClientCall                       ClientCall[]
  ClientSMS                        ClientSMS[]
  ClockInOut                       ClockInOut[]
  Column                           Column[]
  MailgunCredential                MailgunCredential?                 @relation(fields: [mailgunCredentialId], references: [id])
  TwilioCredentials                TwilioCredentials?                 @relation(fields: [twilioCredentialsId], references: [id])
  companyJoinsAsOne                CompanyJoin[]                      @relation("CompanyOne")
  companyJoinsAsTwo                CompanyJoin[]                      @relation("CompanyTwo")
  companyPermissionModules         CompanyPermissionModule[]
  Coupon                           Coupon[]
  emailTemplates                   EmailTemplate[]
  Holiday                          Holiday[]
  inventoryAutomationRule          InventoryAutomationRule[]
  inventoryProducts                InventoryProduct[]
  InventoryProductHistory          InventoryProductHistory[]
  invoices                         Invoice[]
  InvoiceAutomationRule            InvoiceAutomationRule[]
  invoiceTemplates                 InvoiceTemplate[]
  labors                           Labor[]
  Lead                             Lead[]
  leadLink                         LeadLink[]
  LeaveRequest                     LeaveRequest[]
  MailgunEmail                     MailgunEmail[]

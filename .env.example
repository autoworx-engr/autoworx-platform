# Database
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/awx_crm"

# NextAuth / JWT
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-long-random-string"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

ACCESS_SECRET="jwt-access-secret"
REFRESH_SECRET="jwt-refresh-secret"

# Registration gate (required at signup)
ACCESS_CODE="your-invite-code"

# Optional: bcrypt cost factor
SALT_ROUNDS="12"

# Optional: password reset email (Infobip). If unset, reset links are logged server-side in development.
INFOBIP_BASE_URL=""
INFOBIP_API_KEY=""
INFOBIP_DOMAIN=""

#####Development Environment Variables#####
# Connect to Supabase via connection pooling.
DATABASE_URL="postgres://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:6543/postgres?pgbouncer=true"

# Direct connection to the database. Used for migrations.
DIRECT_URL="postgres://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres"

# Authentication secrets
AUTH_SECRET="your-auth-secret-here"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret-here"
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Pusher configuration
PUSHER_ID="your-pusher-id"
PUSHER_KEY="your-pusher-key"
PUSHER_SECRET="your-pusher-secret"
PUSHER_CLUSTER="your-cluster"
NEXT_PUBLIC_PUSHER_KEY="your-pusher-key"
NEXT_PUBLIC_PUSHER_CLUSTER="your-cluster"
NEXT_PUBLIC_PUSHER_INSTANCE_ID="your-pusher-instance-id"
PUSHER_PRIMARY_KEY="your-pusher-primary-key"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Google OAuth configuration
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GMAIL_CLIENT_ID="your-gmail-client-id"
GMAIL_CLIENT_SECRET="your-gmail-client-secret"

# Twilio configuration
TWILIO_ACCOUNT_SID="your-twilio-account-sid"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_PHONE_NUMBER="your-twilio-phone-number"
TWILIO_PHONE_NUMBER_SID="your-twilio-phone-number-sid"
TWILIO_API_KEY_SID="your-twilio-api-key-sid"
TWILIO_API_KEY_SECRET="your-twilio-api-key-secret"

# AWS S3 configuration
AWS_BUCKET_NAME="your-bucket-name"
AWS_BUCKET_REGION="us-east-1"
AWS_ACCESS_KEY="your-aws-access-key"
AWS_SECRET_KEY="your-aws-secret-key"

# Stripe configuration (tenant payment gateway - shops charging their own customers)
STRIPE_SECRET_KEY="sk_test_your-stripe-secret-key"
STRIPE_PUBLISHABLE_KEY="pk_test_your-stripe-publishable-key"
STRIPE_WEBHOOK_SECRET="whsec_your-webhook-secret"
NEXT_PUBLIC_STRIPE_CLIENT_ID="ca_your-stripe-client-id"

# Platform billing - Authorize.net (legacy; AutoWorx billing tenant companies for SaaS plans, being migrated to Stripe)
# Never key environment off NODE_ENV - Railway staging runs NODE_ENV=production.
PLATFORM_AUTHNET_API_LOGIN_ID="your-platform-authnet-login-id"
PLATFORM_AUTHNET_TRANSACTION_KEY="your-platform-authnet-transaction-key"
PLATFORM_AUTHNET_ENVIRONMENT="sandbox" # sandbox|test|development -> sandbox; production|live -> live; anything else -> sandbox
PLATFORM_AUTHNET_SIGNATURE_KEY="your-platform-authnet-webhook-signature-key"
NEXT_PUBLIC_PLATFORM_AUTHNET_API_LOGIN_ID="your-platform-authnet-login-id"
NEXT_PUBLIC_PLATFORM_AUTHNET_CLIENT_KEY="your-platform-authnet-client-key"
NEXT_PUBLIC_PLATFORM_AUTHNET_ENVIRONMENT="sandbox"

# Platform billing - Stripe (AutoWorx billing tenant companies for SaaS plans)
# Separate from the tenant STRIPE_* keys above even if pointed at the same Stripe account.
# Never key environment off NODE_ENV - Railway staging runs NODE_ENV=production.
PLATFORM_STRIPE_SECRET_KEY="sk_test_your-platform-stripe-secret-key"
PLATFORM_STRIPE_WEBHOOK_SECRET="whsec_your-platform-stripe-webhook-secret"
PLATFORM_STRIPE_ENVIRONMENT="sandbox" # sandbox|test -> test mode key; production|live -> live key

# Infobip configuration
INFOBIP_BASE_URL="your-infobip-base-url"
INFOBIP_API_KEY="your-infobip-api-key"
INFOBIP_DOMAIN="your-infobip-domain"

# OneSignal configuration
NEXT_PUBLIC_ONESIGNAL_APP_ID="your-onesignal-app-id"
ONESIGNAL_AUTHORIZATION_KEY="your-onesignal-auth-key"
NEXT_PUBLIC_ONESIGNAL_SAFARI_WEB_ID="your-safari-web-id"

# Application secrets
ACCESS_SECRET="your-access-secret"
REFRESH_SECRET="your-refresh-secret"
ACCESS_CODE="your-access-code"

TRUSTED_PROXY_COUNT=""